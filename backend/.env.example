# ---------------------------------------------------------------
# Configuración del API (copiar a .env para desarrollo local)
# NUNCA versionar el archivo .env con valores reales.
# ---------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO

# Persistencia: "memory" (desarrollo/pruebas) o "firestore" (GCP)
REPOSITORY_BACKEND=memory
GCP_PROJECT_ID=
FIRESTORE_DATABASE=(default)

# JWT — generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-with-a-long-random-secret-of-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Orígenes permitidos para CORS (lista JSON)
CORS_ORIGINS=["http://localhost:4200"]

# Carga los usuarios demo al iniciar (solo aplica con REPOSITORY_BACKEND=memory)
SEED_DEMO_USERS=true
