                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const s = pm.response.json();",
                  "pm.test(\"Total = suma por estado\", () => pm.expect(Object.values(s.by_status).reduce((a, b) => a + b, 0)).to.eql(s.total));",
                  "pm.test(\"Total = suma por prioridad\", () => pm.expect(Object.values(s.by_priority).reduce((a, b) => a + b, 0)).to.eql(s.total));",
